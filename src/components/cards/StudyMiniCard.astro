---
import { formatDate } from '../../lib/utils/format';
import type { Study } from '../../lib/types/content';

const { study } = Astro.props as { study: Study };
---

<article class="h-full overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 transition hover:border-cyan-400/60 hover:bg-slate-900">
  <a href={`/study/${study.slug}`} class="block overflow-hidden">
    <img src={study.coverImage} alt={study.title} class="aspect-[16/7] w-full object-cover transition duration-500 hover:scale-[1.03]" />
  </a>
  <div class="space-y-2 p-4">
    <p class="text-[11px] text-slate-500">{formatDate(study.publishedAt)}</p>
    <a href={`/study/${study.slug}`} class="line-clamp-2 min-h-12 text-base font-semibold leading-6 tracking-tight text-white transition hover:text-cyan-300">
      {study.title}
    </a>
  </div>
</article>
