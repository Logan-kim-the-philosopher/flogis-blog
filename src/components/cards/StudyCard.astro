---
import { getEntrySummary } from '../../lib/services/summary-service';
import { formatDate, joinNames } from '../../lib/utils/format';
import type { Study } from '../../lib/types/content';

const { study, episode, compact = false } = Astro.props as { study?: Study; episode?: Study; compact?: boolean };
const entry = study || episode;
---

{entry && (
  <article class={`overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/60 transition hover:border-cyan-400/60 hover:bg-slate-900 ${compact ? 'h-full' : ''}`}>
    <a href={`/study/${entry.slug}`} class="block overflow-hidden">
      <img
        src={entry.coverImage}
        alt={entry.title}
        class={`w-full object-cover transition duration-500 hover:scale-[1.03] ${compact ? 'aspect-[16/10]' : 'aspect-[16/9]'}`}
      />
    </a>
    <div class={`space-y-3 ${compact ? 'p-4' : 'p-5'}`}>
      {!compact && (
        <div class="flex flex-wrap gap-2">
          {entry.tags?.map((tag) => (
            <span class="rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-300">{tag}</span>
          ))}
        </div>
      )}
      <div>
        <a href={`/study/${entry.slug}`} class={`font-semibold tracking-tight text-white transition hover:text-cyan-300 ${compact ? 'text-lg leading-6' : 'text-xl'}`}>
          {entry.title}
        </a>
        <p class={`mt-2 text-slate-300 ${compact ? 'text-xs leading-5' : 'text-sm leading-6'}`}>{getEntrySummary(entry, compact ? 72 : 110)}</p>
      </div>
      <div class="flex flex-wrap gap-2 text-xs text-slate-400">
        <span>{formatDate(entry.publishedAt)}</span>
        {!compact && (
          <>
            <span>·</span>
            <span>{joinNames(entry.authors)}</span>
          </>
        )}
      </div>
    </div>
  </article>
)}
