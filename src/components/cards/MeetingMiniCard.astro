---
import { formatDate } from '../../lib/utils/format';
import type { Meeting } from '../../lib/types/content';

const { meeting } = Astro.props as { meeting: Meeting };
---

<a href={`/meetings/${meeting.slug}`} class="group block h-full overflow-hidden rounded-2xl border border-slate-800 bg-slate-900/60 transition hover:border-cyan-400/60 hover:bg-slate-900">
  <div class="overflow-hidden">
    <img src={meeting.coverImage} alt={meeting.title} class="aspect-[16/7] w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
  </div>
  <div class="space-y-2 p-4">
    <p class="text-[11px] text-slate-500">{formatDate(meeting.publishedAt)}</p>
    <span class="line-clamp-2 min-h-12 text-base font-semibold leading-6 tracking-tight text-white transition group-hover:text-cyan-300">
      {meeting.title}
    </span>
  </div>
</a>
