---
import { getEntrySummary } from '../../lib/services/summary-service';
import { toArchiveSlug } from '../../lib/services/archive-service';
import { formatDate, joinNames } from '../../lib/utils/format';
import type { Work } from '../../lib/types/content';

const { work, article } = Astro.props as { work?: Work; article?: Work };
const entry = work || article;
---

{entry && (
  <article class="group relative overflow-hidden rounded-3xl border border-slate-800 bg-slate-900/60 transition hover:border-cyan-400/60 hover:bg-slate-900">
    <a href={`/work/${entry.slug}`} class="absolute inset-0 z-10" aria-label={entry.title}></a>
    {entry.coverImage && (
      <div class="pointer-events-none overflow-hidden">
        <img src={entry.coverImage} alt={entry.title} class="aspect-[16/9] w-full object-cover transition duration-500 group-hover:scale-[1.03]" />
      </div>
    )}
    <div class="pointer-events-none relative z-20 space-y-4 p-5">
      <div class="pointer-events-auto relative z-30 flex flex-wrap gap-2">
        {entry.tags?.map((tag) => (
          <a href={`/tags/${encodeURIComponent(toArchiveSlug(tag))}`} class="rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-300 transition hover:border-cyan-400 hover:text-white">{tag}</a>
        ))}
      </div>
      <div>
        <span class="text-xl font-semibold tracking-tight text-white transition group-hover:text-cyan-300">
          {entry.title}
        </span>
        <p class="mt-2 text-sm leading-6 text-slate-300">{getEntrySummary(entry, 110)}</p>
      </div>
      <div class="flex flex-wrap gap-2 text-xs text-slate-400">
        <span>{formatDate(entry.publishedAt)}</span>
        <span>·</span>
        <span>{joinNames(entry.authors)}</span>
      </div>
    </div>
  </article>
)}
