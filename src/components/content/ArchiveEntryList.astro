---
import { getContentHref } from '../../lib/services/content-service';
import { getEntrySummary } from '../../lib/services/summary-service';
import { toArchiveSlug } from '../../lib/services/archive-service';
import { formatDate } from '../../lib/utils/format';
import type { ContentEntry } from '../../lib/types/content';

const { entries } = Astro.props as { entries: ContentEntry[] };

const typeLabel = {
  study: '스터디',
  meeting: '회의',
  work: '작업'
};
---

<div class="space-y-4">
  {entries.map((entry) => (
    <article class="rounded-[1.75rem] border border-slate-800 bg-slate-900/50 p-5 transition hover:border-cyan-400/50">
      <div class="flex flex-wrap items-center gap-2 text-xs text-slate-400">
        <span class="rounded-full border border-slate-700 px-2.5 py-1 text-slate-300">{typeLabel[entry._type]}</span>
        <span>{formatDate(entry.publishedAt)}</span>
      </div>
      <h2 class="mt-3 text-xl font-semibold tracking-tight text-white">
        <a href={getContentHref(entry)} class="transition hover:text-cyan-300">{entry.title}</a>
      </h2>
      <p class="mt-2 text-sm leading-6 text-slate-300">{getEntrySummary(entry, 140)}</p>
      {entry.tags?.length ? (
        <div class="mt-4 flex flex-wrap gap-2">
          {entry.tags.map((tag) => (
            <a href={`/tags/${encodeURIComponent(toArchiveSlug(tag))}`} class="rounded-full border border-slate-700 px-2.5 py-1 text-xs text-slate-300 transition hover:border-cyan-400 hover:text-white">
              {tag}
            </a>
          ))}
        </div>
      ) : null}
    </article>
  ))}
</div>
