---
const {
  eyebrow,
  title,
  description
} = Astro.props as {
  eyebrow?: string;
  title: string;
  description?: string;
};
---

<div class="space-y-3">
  {eyebrow && <p class="text-xs font-medium tracking-tight text-slate-500">{eyebrow}</p>}
  <h1 class="max-w-3xl text-2xl font-semibold tracking-tight text-white md:text-3xl">{title}</h1>
  {description && <p class="max-w-3xl text-base leading-7 text-slate-400">{description}</p>}
</div>
