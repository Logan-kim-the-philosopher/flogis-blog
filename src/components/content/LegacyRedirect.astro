---
const { to, title = '페이지 이동 중' } = Astro.props as { to: string; title?: string };
---

<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={to} />
    <title>{title}</title>
  </head>
  <body>
    <script is:inline define:vars={{ to }}>
      window.location.replace(to);
    </script>
    <main style="font-family: system-ui, sans-serif; padding: 40px; line-height: 1.6;">
      <p>새 경로로 이동합니다.</p>
      <p><a href={to}>{to}</a></p>
    </main>
  </body>
</html>
