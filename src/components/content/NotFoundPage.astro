---
import EmptyState from './EmptyState.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';

const {
  title = '페이지를 찾을 수 없습니다',
  description = '요청한 기록을 찾지 못했습니다.',
  currentPath = Astro.url.pathname
} = Astro.props as {
  title?: string;
  description?: string;
  currentPath?: string;
};
---

<SiteLayout title={title} description={description} currentPath={currentPath}>
  <section class="mx-auto flex min-h-[60vh] max-w-3xl items-center px-4 py-16">
    <EmptyState
      title={title}
      description="주소가 바뀌었거나 아직 공개되지 않은 기록일 수 있습니다. 홈이나 각 아카이브 페이지에서 다시 찾아보세요."
      actionHref="/"
      actionLabel="홈으로 가기"
    />
  </section>
</SiteLayout>
