---
import type { SiteSettings } from '../../lib/types/site';

const { site } = Astro.props as { site: SiteSettings };
---

<footer class="border-t border-slate-800 bg-slate-950/80">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-4 py-8 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between">
    <p>© {new Date().getFullYear()} {site.title}.</p>
    <div class="flex items-center gap-4">
      {site.socialLinks.map((link) => (
        <a href={link.href} class="transition hover:text-white" target="_blank" rel="noreferrer">
          {link.label}
        </a>
      ))}
      <a href="/rss.xml" class="transition hover:text-white">RSS</a>
    </div>
  </div>
</footer>
