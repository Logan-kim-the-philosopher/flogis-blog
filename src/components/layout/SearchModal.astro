---
const { payload } = Astro.props as {
  payload: {
    type: string;
    title: string;
    href: string;
    excerpt: string;
    publishedAt: string;
  }[];
};
---

<div id="search-modal" class="pointer-events-none fixed inset-0 z-[100] hidden" aria-hidden="true">
  <div data-search-backdrop class="absolute inset-0 bg-slate-950/72 backdrop-blur-sm"></div>
  <div class="relative mx-auto flex min-h-screen w-full max-w-4xl items-start justify-center px-4 pt-20">
    <div data-search-panel class="w-full overflow-hidden rounded-[2rem] border border-slate-800 bg-slate-950/96 shadow-2xl shadow-cyan-950/30">
      <div class="border-b border-slate-800 px-5 py-4 sm:px-6">
        <div class="flex items-center gap-3">
          <input
            id="search-modal-input"
            type="search"
            placeholder="검색..."
            class="w-full bg-transparent text-base text-white outline-none placeholder:text-slate-500"
            autocomplete="off"
          />
          <button
            type="button"
            data-search-close
            aria-label="검색 닫기"
            class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-slate-700 text-slate-300 transition hover:border-cyan-400 hover:text-white"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
              <path d="M7 7l10 10"></path>
              <path d="M17 7L7 17"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="max-h-[65vh] overflow-y-auto px-5 py-4 sm:px-6">
        <div class="pb-3 text-sm text-slate-400" id="search-modal-section-title"></div>
        <div id="search-modal-results" class="grid gap-2"></div>
      </div>
    </div>
  </div>
</div>

<script type="module" define:vars={{ payload }}>
  const STORAGE_KEY = 'flogi-search-history';
  const HISTORY_LIMIT = 6;
  const modal = document.querySelector('#search-modal');
  const input = document.querySelector('#search-modal-input');
  const results = document.querySelector('#search-modal-results');
  const sectionTitle = document.querySelector('#search-modal-section-title');
  const openerSelectors = '[data-search-open]';
  const panel = modal?.querySelector('[data-search-panel]');

  const formatDate = (value) => {
    try {
      return new Intl.DateTimeFormat('ko-KR', { year: 'numeric', month: 'short', day: 'numeric' }).format(
        new Date(value)
      );
    } catch {
      return value;
    }
  };

  const getHistory = () => {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY) || '[]');
    } catch {
      return [];
    }
  };

  const setHistory = (items) => {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(items.slice(0, HISTORY_LIMIT)));
  };

  const saveHistory = (item) => {
    const next = [item, ...getHistory().filter((entry) => entry.href !== item.href)];
    setHistory(next);
  };

  const renderCards = (items) =>
    items
      .map(
        (item) => `
          <a href="${item.href}" data-search-item="${item.href}" class="block rounded-[1.25rem] border border-slate-800 bg-slate-900/55 px-4 py-4 transition hover:border-cyan-400/60 hover:bg-slate-900">
            <div class="flex items-center justify-between gap-4">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-cyan-300">${item.type}</p>
              <p class="shrink-0 text-xs text-slate-500">${formatDate(item.publishedAt)}</p>
            </div>
            <h2 class="mt-2 text-lg font-semibold tracking-tight text-white">${item.title}</h2>
            <p class="mt-1 text-sm leading-6 text-slate-300">${item.excerpt}</p>
          </a>
        `
      )
      .join('');

  const renderRecent = () => {
    const history = getHistory();
    sectionTitle.textContent = '최근 검색';
    results.innerHTML = history.length
      ? renderCards(history)
      : '<div class="flex min-h-44 items-center justify-center rounded-b-[1.5rem] text-sm text-slate-500">최근 검색 기록이 없습니다</div>';
  };

  const renderSearch = (query = '') => {
    const normalized = query.trim().toLowerCase();
    if (!normalized) {
      renderRecent();
      return;
    }

    const filtered = payload.filter((item) =>
      [item.title, item.excerpt, item.type].join(' ').toLowerCase().includes(normalized)
    );

    sectionTitle.textContent = '검색 결과';
    results.innerHTML = filtered.length
      ? renderCards(filtered)
      : '<div class="flex min-h-44 items-center justify-center rounded-b-[1.5rem] text-sm text-slate-500">검색 결과가 없습니다</div>';
  };

  const openModal = () => {
    modal?.classList.remove('hidden');
    modal?.classList.remove('pointer-events-none');
    modal?.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
    renderSearch(input?.value || '');
    requestAnimationFrame(() => input?.focus());
  };

  const closeModal = () => {
    modal?.classList.add('hidden');
    modal?.classList.add('pointer-events-none');
    modal?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  };

  document.querySelectorAll(openerSelectors).forEach((button) => {
    button.addEventListener('click', (event) => {
      event.preventDefault();
      openModal();
    });
  });

  input?.addEventListener('input', (event) => renderSearch(event.currentTarget.value));
  modal?.querySelector('[data-search-backdrop]')?.addEventListener('click', closeModal);
  modal?.querySelector('[data-search-close]')?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (event) => {
    if (!(event.target instanceof Node)) return;
    if (panel?.contains(event.target)) return;
    closeModal();
  });
  results?.addEventListener('click', (event) => {
    const target = event.target;
    const link = target instanceof Element ? target.closest('a') : null;
    if (!link) return;
    const item = payload.find((entry) => entry.href === link.getAttribute('href')) || getHistory().find((entry) => entry.href === link.getAttribute('href'));
    if (item) saveHistory(item);
    closeModal();
  });

  window.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openModal();
    }

    if (event.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  renderRecent();
</script>
