---
import '../styles/global.css';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import SEOHead from '../components/content/SEOHead.astro';
import SearchModal from '../components/layout/SearchModal.astro';
import { getRuntimeSiteUrl } from '../lib/config/runtime';
import { getSiteSettings } from '../lib/repositories/site';
import type { SiteSettings } from '../lib/types/site';

const {
  title,
  description,
  image,
  currentPath = Astro.url.pathname,
  site: providedSite
} = Astro.props as {
  title?: string;
  description?: string;
  image?: string | null;
  currentPath?: string;
  site?: SiteSettings;
};

const site = providedSite || await getSiteSettings();
const pageTitle = title ? `${title} | ${site.title}` : site.seo?.title || site.title;
const pageDescription = description || site.seo?.description || site.description;
const pageImage = image === null ? undefined : image || site.seo?.image;
const canonical = new URL(currentPath, getRuntimeSiteUrl(Astro.url)).toString();
---

<!doctype html>
<html lang="ko" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <SEOHead title={pageTitle} description={pageDescription} image={pageImage} canonical={canonical} />
  </head>
  <body class="flex min-h-screen flex-col bg-slate-950 text-slate-100 antialiased">
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(circle_at_top,_rgba(34,211,238,0.18),_transparent_35%),linear-gradient(180deg,_rgba(15,23,42,0.95),_rgba(2,6,23,1))]"></div>
    <Header site={site} currentPath={currentPath} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer site={site} />
    <SearchModal />
    <script type="module">
      import mermaid from 'https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs';

      mermaid.initialize({ startOnLoad: false, theme: 'dark', securityLevel: 'loose' });

      const renderMermaid = async () => {
        const nodes = Array.from(document.querySelectorAll('.mermaid')).filter(
          (node) => !node.hasAttribute('data-mermaid-rendered')
        );
        if (!nodes.length) return;

        for (const node of nodes) {
          const definition = node.textContent?.trim();
          if (!definition) continue;

          try {
            const id = `mermaid-${crypto.randomUUID()}`;
            const { svg, bindFunctions } = await mermaid.render(id, definition);
            node.innerHTML = svg;
            bindFunctions?.(node);
            node.setAttribute('data-mermaid-rendered', 'true');
          } catch (error) {
            const message = error instanceof Error ? error.message : String(error);
            node.innerHTML = `<pre>Mermaid render failed\n${message}\n\n${definition}</pre>`;
            node.setAttribute('data-mermaid-rendered', 'error');
          }
        }
      };

      renderMermaid();
      document.addEventListener('astro:page-load', renderMermaid);
    </script>
  </body>
</html>
