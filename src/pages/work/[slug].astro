---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getWorkBySlug, getWorks } from '../../lib/repositories/works';
import { getEntrySummary } from '../../lib/services/summary-service';
import { formatDate, joinNames } from '../../lib/utils/format';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { slug: work.slug } }));
}

const { slug } = Astro.params;
const work = slug ? await getWorkBySlug(slug) : undefined;

if (!work) {
  throw new Error(`Work not found for slug: ${slug}`);
}
---

<SiteLayout title={work.title} description={getEntrySummary(work, 160)} image={work.coverImage}>
  <article class="mx-auto max-w-4xl px-4 pb-20 pt-12">
    <div class="space-y-5">
      <div class="flex flex-wrap gap-2">
        {work.tags?.map((tag) => (
          <span class="rounded-full border border-slate-700 px-3 py-1 text-sm text-slate-300">{tag}</span>
        ))}
      </div>
      <h1 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">{work.title}</h1>
      <div class="flex flex-wrap gap-3 text-sm text-slate-400">
        <span>{formatDate(work.publishedAt)}</span>
        <span>·</span>
        <span>작성: {joinNames(work.authors)}</span>
      </div>
    </div>

    <img src={work.coverImage} alt={work.title} class="mt-10 aspect-video w-full rounded-[2rem] border border-slate-800 object-cover" />
    <div class="rich-text mt-10" set:html={work.body} />
  </article>
</SiteLayout>
