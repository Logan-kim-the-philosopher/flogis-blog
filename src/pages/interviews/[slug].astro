---
import LegacyRedirect from '../../components/content/LegacyRedirect.astro';
import { getMeetings } from '../../lib/repositories/meetings';

export async function getStaticPaths() {
  const meetings = await getMeetings();
  return meetings.map((meeting) => ({ params: { slug: meeting.slug } }));
}

const { slug } = Astro.params;
---

<LegacyRedirect to={`/meetings/${slug}`} title="회의 상세로 이동 중" />
