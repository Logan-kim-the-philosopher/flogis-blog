---
import ArchiveEntryList from '../../components/content/ArchiveEntryList.astro';
import ContentHeader from '../../components/content/ContentHeader.astro';
import EmptyState from '../../components/content/EmptyState.astro';
import NotFoundPage from '../../components/content/NotFoundPage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getPersonArchiveBySlug } from '../../lib/services/archive-service';

const { slug } = Astro.params;
const { person, entries } = slug ? await getPersonArchiveBySlug(slug) : { person: undefined, entries: [] };

if (!person) {
  Astro.response.status = 404;
}
---

{person ? (
<SiteLayout title={person.name} description={person.bio || `${person.name}와 연결된 콘텐츠 모음입니다.`} image={person.avatar} currentPath={`/people/${person.slug}`}>
  <section class="mx-auto max-w-5xl px-4 pb-10 pt-10">
    <div class="rounded-[2rem] border border-slate-800 bg-slate-900/50 p-6 md:p-8">
      <div class="flex flex-col gap-6 md:flex-row md:items-center">
        {person.avatar ? (
          <img src={person.avatar} alt={person.name} class="h-20 w-20 rounded-full border border-slate-800 object-cover" />
        ) : (
          <div class="flex h-20 w-20 items-center justify-center rounded-full border border-slate-800 bg-slate-900 text-sm text-slate-500">인물</div>
        )}
        <div>
          <ContentHeader title={person.name} description={person.bio || '관련 기록을 모아볼 수 있습니다.'} />
          {person.role && <p class="mt-3 text-sm text-slate-400">역할: {person.role}</p>}
          {person.links?.length ? (
            <div class="mt-4 flex flex-wrap gap-2">
              {person.links.map((link) => (
                <a href={link.href} target="_blank" rel="noreferrer" class="rounded-full border border-slate-700 px-3 py-1 text-sm text-slate-300 transition hover:border-cyan-400 hover:text-white">
                  {link.label}
                </a>
              ))}
            </div>
          ) : null}
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    {entries.length ? (
      <ArchiveEntryList entries={entries} />
    ) : (
      <EmptyState title="연결된 기록이 없습니다" description="이 사람과 연결된 콘텐츠가 아직 없습니다." actionHref="/people" actionLabel="사람 목록으로" />
    )}
  </section>
</SiteLayout>
) : (
  <NotFoundPage title="사람을 찾을 수 없습니다" />
)}
