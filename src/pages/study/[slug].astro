---
import DetailBreadcrumb from '../../components/content/DetailBreadcrumb.astro';
import NotFoundPage from '../../components/content/NotFoundPage.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getStudyBySlug } from '../../lib/repositories/studies';
import { toArchiveSlug } from '../../lib/services/archive-service';
import { getEntrySummary } from '../../lib/services/summary-service';
import { formatDate } from '../../lib/utils/format';

const { slug } = Astro.params;
const study = slug ? await getStudyBySlug(slug) : undefined;

if (!study) {
  Astro.response.status = 404;
}
---

{study ? (
  <SiteLayout title={study.title} description={getEntrySummary(study, 160)} image={study.coverImage ?? null}>
    <article class="mx-auto max-w-4xl px-4 pb-20 pt-12">
      <div class="space-y-5">
        <DetailBreadcrumb backHref="/study" items={[{ label: '홈', href: '/' }, { label: '스터디', href: '/study' }, { label: study.title }]} />
        <h1 class="text-4xl font-semibold tracking-tight text-white md:text-5xl">{study.title}</h1>
        <div class="flex flex-wrap gap-3 text-sm text-slate-400">
          <span>{formatDate(study.publishedAt)}</span>
          <span>·</span>
          <div class="flex flex-wrap items-center gap-2">
            <span>작성:</span>
            {study.authors.map((author) => (
              <a href={`/people/${author.slug}`} class="transition hover:text-cyan-300">{author.name}</a>
            ))}
          </div>
        </div>
      </div>

      {study.coverImage && (
        <img src={study.coverImage} alt={study.title} class="mt-10 aspect-video w-full rounded-[2rem] border border-slate-800 object-cover" />
      )}

      <div class="mt-10 flex flex-wrap gap-2">
        {study.tags?.map((tag) => (
          <a href={`/tags/${encodeURIComponent(toArchiveSlug(tag))}`} class="rounded-full border border-slate-700 px-3 py-1 text-sm text-slate-300 transition hover:border-cyan-400 hover:text-white">{tag}</a>
        ))}
      </div>

      <div class="rich-text mt-10" set:html={study.body} />
    </article>
  </SiteLayout>
) : (
  <NotFoundPage title="스터디를 찾을 수 없습니다" />
)}
