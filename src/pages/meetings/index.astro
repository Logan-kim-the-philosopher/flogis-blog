---
import MeetingCard from '../../components/cards/MeetingCard.astro';
import ContentHeader from '../../components/content/ContentHeader.astro';
import EmptyState from '../../components/content/EmptyState.astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { getMeetings } from '../../lib/repositories/meetings';

const meetings = await getMeetings();
---

<SiteLayout title="회의" description="대화, 회의, 논의 기록 아카이브" currentPath="/meetings">
  <section class="mx-auto max-w-5xl px-4 pb-10 pt-10">
    <ContentHeader title="회의" description="대화, 논의, 결정 사항을 간결하게 남겨두는 기록입니다." />
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-16">
    {
      meetings.length ? (
        <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
          {meetings.map((meeting) => <MeetingCard meeting={meeting} />)}
        </div>
      ) : (
        <EmptyState
          title="아직 회의 기록이 없습니다"
          description="회의나 인터뷰 문서를 발행하면 이 페이지에 자동으로 표시됩니다."
        />
      )
    }
  </section>
</SiteLayout>
