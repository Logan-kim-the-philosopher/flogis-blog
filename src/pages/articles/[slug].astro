---
import LegacyRedirect from '../../components/content/LegacyRedirect.astro';
import { getWorks } from '../../lib/repositories/works';

export async function getStaticPaths() {
  const works = await getWorks();
  return works.map((work) => ({ params: { slug: work.slug } }));
}

const { slug } = Astro.params;
---

<LegacyRedirect to={`/work/${slug}`} title="작업 상세로 이동 중" />
