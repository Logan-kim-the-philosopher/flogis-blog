pipeline {
    agent {
        label 'docker-build'
    }

    environment {
        HARBOR_REGISTRY = 'harbor.192.168.0.110.nip.io'
        HARBOR_PROJECT = 'flogis-blog'
        HARBOR_CRED = 'harbor-credentials'
        IMAGE_NAME = 'site'

        REPOSITORY_URL = 'https://github.com/Logan-kim-the-philosopher/flogis-blog.git'
        GIT_CRED = 'flogis-blog-github-credentials'
        SOURCE_BRANCH = 'Haru2_dev'
        DEPLOY_BRANCH = 'deploy'

        PUBLIC_SITE_URL = 'https://flogis-blog.tail2dac17.ts.net'
        SANITY_PROJECT_ID = 'w1jypogd'
        SANITY_DATASET = 'production'
        SANITY_API_VERSION = '2025-08-22'
        SANITY_STRICT_CONTENT = 'true'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 45, unit: 'MINUTES')
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
    }

    triggers {
        pollSCM('H/2 * * * *')
    }

    stages {
        stage('Checkout Haru2_dev') {
            steps {
                checkout scm
                sh '''
                    set -eu
                    test -f infra/jenkins/Jenkinsfile
                    test -f infra/k8s/overlays/prod/kustomization.yaml
                    rm -rf .jenkins-work build/provenance
                    mkdir -p .jenkins-work build/provenance
                '''
                script {
                    env.SOURCE_SHA = sh(
                        script: 'git rev-parse --short=8 HEAD',
                        returnStdout: true
                    ).trim()
                    env.IMAGE_TAG = env.BUILD_NUMBER + '-' + env.SOURCE_SHA
                    echo "Immutable image tag: " + env.IMAGE_TAG
                }
            }
        }

        stage('Ensure Harbor Project') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.HARBOR_CRED,
                    usernameVariable: 'HARBOR_USER',
                    passwordVariable: 'HARBOR_PASSWORD'
                )]) {
                    sh '''
                        set -eu
                        response_code=$(curl --silent --show-error \
                          --output .jenkins-work/harbor-project-response.json \
                          --write-out '%{http_code}' \
                          --user "$HARBOR_USER:$HARBOR_PASSWORD" \
                          --header 'Content-Type: application/json' \
                          --data '{"project_name":"flogis-blog","public":false}' \
                          "https://$HARBOR_REGISTRY/api/v2.0/projects")
                        case "$response_code" in
                          201|409) ;;
                          *)
                            cat .jenkins-work/harbor-project-response.json
                            echo "Harbor project creation failed: HTTP $response_code" >&2
                            exit 1
                            ;;
                        esac
                    '''
                }
            }
        }

        stage('Build Image') {
            steps {
                sh '''
                    set -eu
                    docker build \
                      --build-arg "PUBLIC_SITE_URL=$PUBLIC_SITE_URL" \
                      --build-arg "SANITY_PROJECT_ID=$SANITY_PROJECT_ID" \
                      --build-arg "SANITY_DATASET=$SANITY_DATASET" \
                      --build-arg "SANITY_API_VERSION=$SANITY_API_VERSION" \
                      --build-arg "SANITY_STRICT_CONTENT=$SANITY_STRICT_CONTENT" \
                      --tag "$HARBOR_REGISTRY/$HARBOR_PROJECT/$IMAGE_NAME:$IMAGE_TAG" \
                      --file infra/docker/Dockerfile .
                '''
            }
        }

        stage('Push and Verify Harbor Image') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.HARBOR_CRED,
                    usernameVariable: 'HARBOR_USER',
                    passwordVariable: 'HARBOR_PASSWORD'
                )]) {
                    sh '''
                        set -eu
                        reference="$HARBOR_REGISTRY/$HARBOR_PROJECT/$IMAGE_NAME:$IMAGE_TAG"
                        echo "$HARBOR_PASSWORD" | docker login "$HARBOR_REGISTRY" \
                          --username "$HARBOR_USER" --password-stdin
                        docker push "$reference"
                        docker image rm "$reference"
                        docker pull "$reference"
                        docker logout "$HARBOR_REGISTRY" || true
                    '''
                }
            }
        }

        stage('Smoke Test') {
            steps {
                sh '''
                    set -eu
                    container="flogis-blog-smoke-$BUILD_NUMBER"
                    reference="$HARBOR_REGISTRY/$HARBOR_PROJECT/$IMAGE_NAME:$IMAGE_TAG"
                    docker run -d --name "$container" "$reference"

                    attempts=30
                    until docker exec "$container" wget -q -O /dev/null http://127.0.0.1:8080/healthz; do
                      attempts=$((attempts - 1))
                      if [ "$attempts" -le 0 ]; then
                        docker logs "$container" >&2 || true
                        exit 1
                      fi
                      sleep 1
                    done

                    docker exec "$container" wget -q -O /dev/null http://127.0.0.1:8080/
                    docker exec "$container" wget -q -O /dev/null http://127.0.0.1:8080/study/
                '''
            }
        }

        stage('Record Provenance') {
            steps {
                sh '''
                    set -eu
                    reference="$HARBOR_REGISTRY/$HARBOR_PROJECT/$IMAGE_NAME:$IMAGE_TAG"
                    {
                      echo "source_commit=$(git rev-parse HEAD)"
                      echo "source_branch=$SOURCE_BRANCH"
                      echo "image_tag=$IMAGE_TAG"
                      docker image inspect --format '{{index .RepoDigests 0}}' "$reference"
                    } > build/provenance/image.txt
                '''
                archiveArtifacts artifacts: 'build/provenance/image.txt', fingerprint: true
            }
        }

        stage('Update Deploy Branch') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: env.GIT_CRED,
                    usernameVariable: 'GIT_USER',
                    passwordVariable: 'GIT_TOKEN'
                )]) {
                    sh '''
                        set -eu
                        git config user.email "jenkins@flogis-blog.local"
                        git config user.name "Jenkins CI"
                        git remote set-url origin \
                          "https://$GIT_USER:$GIT_TOKEN@github.com/Logan-kim-the-philosopher/flogis-blog.git"
                        trap 'git remote set-url origin "$REPOSITORY_URL"' EXIT

                        git fetch --prune origin \
                          "+refs/heads/$SOURCE_BRANCH:refs/remotes/origin/$SOURCE_BRANCH"
                        git fetch --prune origin \
                          "+refs/heads/$DEPLOY_BRANCH:refs/remotes/origin/$DEPLOY_BRANCH" || true
                        git checkout -B "$DEPLOY_BRANCH" "refs/remotes/origin/$SOURCE_BRANCH"

                        KUSTOMIZE_FILE=infra/k8s/overlays/prod/kustomization.yaml \
                        IMAGE_TAG_VALUE="$IMAGE_TAG" \
                        python3 - <<'PY'
import os
from pathlib import Path

path = Path(os.environ["KUSTOMIZE_FILE"])
tag = os.environ["IMAGE_TAG_VALUE"]
target = "harbor.192.168.0.110.nip.io/flogis-blog/site"

lines = path.read_text(encoding="utf-8").splitlines()
current_image = None
updated = False
output = []

for line in lines:
    stripped = line.strip()
    if stripped.startswith("- name:"):
        current_image = stripped.split(":", 1)[1].strip()
    elif current_image == target and stripped.startswith("newTag:"):
        indent = line[: len(line) - len(line.lstrip())]
        line = f"{indent}newTag: {tag}"
        updated = True
        current_image = None
    output.append(line)

if not updated:
    raise SystemExit(f"missing image entry: {target}")

path.write_text("\n".join(output) + "\n", encoding="utf-8")
PY

                        git add infra/k8s/overlays/prod/kustomization.yaml
                        git commit -m "deploy: flogis-blog $IMAGE_TAG"
                        git push --force-with-lease origin "HEAD:$DEPLOY_BRANCH"
                    '''
                }
            }
        }
    }

    post {
        always {
            sh '''
                docker rm -f "flogis-blog-smoke-$BUILD_NUMBER" >/dev/null 2>&1 || true
                rm -rf .jenkins-work
            '''
        }
    }
}
